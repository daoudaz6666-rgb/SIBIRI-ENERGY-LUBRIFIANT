<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_lubricant" model="ir.ui.view">
        <field name="name">purchase.order.form.lubricant</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_import_file"
                        string="Créer le dossier d'importation"
                        type="object"
                        invisible="state not in ('purchase', 'done') or import_file_ids"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Importation" name="lubricant_import">
                    <field name="import_file_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="phase" widget="badge"/>
                            <field name="progress" widget="progressbar"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
