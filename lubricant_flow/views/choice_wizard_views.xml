<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lubricant_choice_wizard_view_form" model="ir.ui.view">
        <field name="name">lubricant.choice.wizard.form</field>
        <field name="model">lubricant.choice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="text-center py-3">
                    <h3>Que souhaitez-vous faire ?</h3>
                    <p class="text-muted">Choisissez le circuit à ouvrir.</p>
                </div>
                <footer class="justify-content-center">
                    <button name="action_open_purchase" type="object"
                            string="Achat de lubrifiants" class="btn-primary"/>
                    <button name="action_open_sale" type="object"
                            string="Vente de lubrifiants" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="lubricant_choice_wizard_action" model="ir.actions.act_window">
        <field name="name">Lubrifiants</field>
        <field name="res_model">lubricant.choice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lubricant_root" name="Lubrifiants" sequence="50"
              action="lubricant_choice_wizard_action"/>
</odoo>
