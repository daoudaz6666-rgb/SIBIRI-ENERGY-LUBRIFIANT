<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lubricant_home_card_view_kanban" model="ir.ui.view">
        <field name="name">lubricant.home.card.kanban</field>
        <field name="model">lubricant.home.card</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0"
                    action="action_open" type="object">
                <field name="name"/>
                <field name="circuit"/>
                <field name="icon"/>
                <templates>
                    <t t-name="card" class="text-center">
                        <div class="py-5 px-4 rounded text-white"
                             t-att-style="'min-height: 240px; ' + (record.circuit.raw_value === 'purchase' ? 'background-color: #0d6efd;' : 'background-color: #198754;')">
                            <div class="mb-4" style="font-size: 4.5rem; line-height: 1;">
                                <field name="icon"/>
                            </div>
                            <h2 class="text-white mb-0"><field name="name"/></h2>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="lubricant_home_action" model="ir.actions.act_window">
        <field name="name">Lubrifiants</field>
        <field name="res_model">lubricant.home.card</field>
        <field name="view_mode">kanban</field>
    </record>

    <menuitem id="menu_lubricant_root" name="Lubrifiants" sequence="50"
              action="lubricant_home_action"/>
</odoo>
