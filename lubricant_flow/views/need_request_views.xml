<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lubricant_need_request_view_list" model="ir.ui.view">
        <field name="name">lubricant.need.request.list</field>
        <field name="model">lubricant.need.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="requester_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="lubricant_need_request_view_form" model="ir.ui.view">
        <field name="name">lubricant.need.request.form</field>
        <field name="model">lubricant.need.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Soumettre" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approuver" type="object"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_create_rfq" string="Créer la demande de prix"
                            type="object" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state in ('ordered', 'cancel')"/>
                    <button name="action_reset_draft" string="Remettre en brouillon"
                            type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,ordered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Achat</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state in ('ordered', 'cancel')"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="purchase_id" invisible="not purchase_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Produits" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarques" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="lubricant_need_request_action" model="ir.actions.act_window">
        <field name="name">Fiches de besoin</field>
        <field name="res_model">lubricant.need.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
