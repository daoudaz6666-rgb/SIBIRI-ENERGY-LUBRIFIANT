<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Facture proforma (vente) -->
    <record id="action_report_lubricant_proforma" model="ir.actions.report">
        <field name="name">Facture proforma lubrifiants</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lubricant_flow.report_lubricant_proforma</field>
        <field name="print_report_name">'Proforma - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_lubricant_proforma">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>FACTURE PROFORMA <span t-field="o.name"/></h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Client :</strong><br/>
                                <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <strong>Date :</strong> <span t-field="o.date_order" t-options='{"widget": "date"}'/><br/>
                                <strong>Retrait prévu :</strong> <span t-field="o.pickup_date"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Désignation</th>
                                    <th class="text-end">Quantité</th>
                                    <th class="text-end">Prix unitaire</th>
                                    <th class="text-end">Montant HT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                        <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Total HT</strong></td>
                                        <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                    </tr>
                                    <tr>
                                        <td>Taxes</td>
                                        <td class="text-end"><span t-field="o.amount_tax"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total TTC</strong></td>
                                        <td class="text-end"><span t-field="o.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <p class="text-muted mt-4">
                            Ce document est un devis préalable : il ne vaut pas facture définitive
                            et n'engage la livraison qu'après confirmation par un bon de commande.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
